# ==========================================
# NEUROLAB ENTERPRISE - CONFIGURACIÓN LOCAL
# ==========================================
# Copie este archivo como .env en la raíz del repositorio:
#   Copy-Item .env.local.example .env
#
# La API y el worker leen el .env de la raíz. Docker Compose usa el mismo
# archivo, pero sobreescribe DATABASE_URL, Redis y DATA_DIR/MODEL_DIR.
#
# Para Supabase puede generar la conexión automáticamente con:
#   python scripts/setup_supabase_db.py --write-env

ENVIRONMENT=development
LOG_LEVEL=INFO
# Eco de SQL para depuración. Déjelo en false: multiplica el I/O de logs.
SQL_ECHO=false

SECRET_KEY=change_this_to_a_super_secret_enterprise_key_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
TRUSTED_PROXY_IPS=127.0.0.1,::1
STREAM_TICKET_TTL_SECONDS=30

SEED_ADMIN_EMAIL=admin@neurolab.enterprise
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador NeuroLab

# --- Opción A: Supabase Postgres (Session pooler) ---
# Reemplace <ref>, <password> y <region>. Codifique la contraseña si contiene
# @ : / # (por ejemplo @ -> %40).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Opción B: SQLite local ---
# DATABASE_URL=sqlite+aiosqlite:///C:/Users/sanhu/Desktop/NeuroLab_Enterprise/services/api/data/neurolab.db

# Cola en disco para ejecutar API y worker en la misma máquina.
QUEUE_BACKEND=filesystem
TRAINING_QUEUE=neurolab:training:queue
QUEUE_POLL_SECONDS=2
# Segundos sin heartbeat tras los cuales un trabajo RUNNING/PREPARING se
# considera huérfano y se marca FAILED al arrancar cualquier worker.
WORKER_HEARTBEAT_TIMEOUT_SECONDS=900

# Rutas relativas a services/api, compartidas por API y worker.
DATA_DIR=data/uploads
MODEL_DIR=data/models
TEMP_DIR=data/tmp

STORAGE_BACKEND=local
MAX_UPLOAD_MB=50
MAX_CSV_ROWS=500000
MAX_CSV_COLUMNS=500

# Inferencia opcional: instale services/api/requirements-inference.txt para
# habilitar POST /models/{id}/predict. Con true sólo se sirven modelos APPROVED.
INFERENCE_REQUIRE_APPROVED=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=
