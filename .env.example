# ==========================================
# NEUROLAB ENTERPRISE - ENVIRONMENT CONFIG
# ==========================================
# Plantilla para Docker Compose y despliegue cloud.
# Para ejecutar en tu PC sin Docker use .env.local.example.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
# Eco de SQL para depuración. Déjelo en false: multiplica el I/O de logs.
SQL_ECHO=false
VERSION=1.0.0

# Security & Authentication
SECRET_KEY=change_this_to_a_super_secret_enterprise_key_in_production_32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Bloqueo temporal por cuenta tras fallos consecutivos de contraseña.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Proxies de confianza para leer X-Forwarded-For (IP o CIDR). En Docker,
# añada la subred del proxy; nunca deje "*".
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Vida del ticket de un solo uso para SSE/WebSocket.
STREAM_TICKET_TTL_SECONDS=30

# Bootstrap admin (solo se crea si la tabla users está vacía).
# Defina una contraseña robusta (mínimo 12 caracteres). Si se deja vacía,
# el primer arranque genera una aleatoria y la muestra una sola vez en los logs.
SEED_ADMIN_EMAIL=admin@neurolab.enterprise
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador NeuroLab

# PostgreSQL Database
POSTGRES_USER=neurolab
POSTGRES_PASSWORD=neurolab_secure_pass
POSTGRES_DB=neurolab_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://neurolab:neurolab_secure_pass@postgres:5432/neurolab_db

# Redis Message Broker & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
QUEUE_BACKEND=redis
TRAINING_QUEUE=neurolab:training:queue
QUEUE_POLL_SECONDS=2
# Segundos sin heartbeat tras los cuales un trabajo RUNNING/PREPARING se
# considera huérfano y se marca FAILED al arrancar cualquier worker.
WORKER_HEARTBEAT_TIMEOUT_SECONDS=900

# Shared artifact storage (API y worker deben apuntar al mismo volumen)
DATA_DIR=/data/uploads
MODEL_DIR=/data/models
MAX_UPLOAD_MB=50
MAX_CSV_ROWS=500000
MAX_CSV_COLUMNS=500

# Almacenamiento: local | s3 (Supabase Storage, MinIO, AWS S3, R2)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=neurolab
S3_FORCE_PATH_STYLE=true

# Inferencia opcional (requiere instalar services/api/requirements-inference.txt
# o compilar el Dockerfile.api con INSTALL_INFERENCE=true). Con true sólo se
# sirven modelos en estado APPROVED.
INFERENCE_REQUIRE_APPROVED=false
# Docker Compose: instala TensorFlow/scikit-learn en la imagen de la API.
INSTALL_INFERENCE=false

# CORS (solo necesario si el frontend no se sirve tras el proxy Nginx)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=

# Frontend Configuration (build-time para Vite)
VITE_API_URL=/api/v1

# ==========================================
# DESPLIEGUE CLOUD (Supabase + Vercel + Railway)
# ==========================================
# Descomente y complete solo en el panel de Railway/Vercel. No suba secretos
# reales a este archivo.
#
# ENVIRONMENT=production
# SECRET_KEY=<clave-aleatoria-de-32-o-mas-caracteres>
# SEED_ADMIN_EMAIL=admin@su-dominio.com
# SEED_ADMIN_PASSWORD=<contraseña-inicial-robusta>
#
# Supabase: use el "Session pooler" (puerto 5432) y conserve sslmode=require.
# DATABASE_URL=postgresql://postgres.<ref>:<password-urlencoded>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Supabase Storage (Settings > Storage > S3 access keys)
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<ref>.supabase.co/storage/v1/s3
# S3_REGION=<region-del-proyecto>
# S3_ACCESS_KEY_ID=<access-key>
# S3_SECRET_ACCESS_KEY=<secret-key>
# S3_BUCKET=neurolab
# S3_FORCE_PATH_STYLE=true
#
# Redis de Railway (referencia de variable del servicio Redis)
# REDIS_URL=${{Redis.REDIS_URL}}
# QUEUE_BACKEND=redis
#
# Inferencia opcional en la API (build-arg + política de servicio)
# INSTALL_INFERENCE=true
# INFERENCE_REQUIRE_APPROVED=true
#
# CORS: enumere únicamente sus dominios exactos. Evite comodines o regex
# amplios en producción.
# CORS_ORIGINS=https://<frontend>.vercel.app
# CORS_ORIGIN_REGEX=
#
# Vercel (build-time)
# VITE_API_URL=https://<api>.up.railway.app/api/v1
