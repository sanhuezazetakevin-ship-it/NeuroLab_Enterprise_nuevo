# Copia este archivo como .env.local para desarrollo o define esta variable en
# Vercel (Production y Preview) para el despliegue.
#
# Local real (scripts/start_local.ps1):
VITE_API_URL=http://127.0.0.1:8012/api/v1
#
# Producción (Vercel → Project Settings → Environment Variables):
# VITE_API_URL=https://<tu-api>.up.railway.app/api/v1
#
# VITE_API_URL se incrusta en el build: si cambia la URL de la API hay que
# volver a desplegar el frontend.
